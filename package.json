{
  "name": "@nullroar/axisymmetric-kinematic-consensus",
  "version": "1.0.0",
  "description": "A deterministic consensus substrate for axisymmetric displacement projection.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "akcp": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:protocol": "npm run build && node scripts/protocol-conformance.mjs",
    "verify": "npm run typecheck && npm run verify:architecture && npm run test && npm run verify:protocol",
    "demo": "npm run build && node dist/examples/minimal.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "prepack": "npm run clean && npm run verify && npm run build"
  },
  "keywords": [
    "event-sourcing",
    "fixed-point",
    "cqrs",
    "determinism",
    "kinematics",
    "consensus",
    "projection"
  ],
  "author": "Nullroar",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
